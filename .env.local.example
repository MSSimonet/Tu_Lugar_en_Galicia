# .env.local.example
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repo (ya está en .gitignore).
# Las mismas variables deben cargarse en Vercel → Settings → Environment Variables.

# ── Fase 1: Leads (Airtable) ─────────────────────────────────────────────────
# Obtener en: https://airtable.com → Account → API → Personal access tokens
AIRTABLE_API_KEY=

# ID de la base de Airtable. En la URL: airtable.com/[AIRTABLE_BASE_ID]/...
AIRTABLE_BASE_ID=

# Nombre exacto de la tabla donde se guardan los leads (ej: "Leads Fase 1")
AIRTABLE_TABLE_NAME=

# ── Fase 1: El Marcador (Google Sheets) ──────────────────────────────────────
# ID de la Google Sheet del Marcador. En la URL: docs.google.com/spreadsheets/d/[SHEET_MARCADOR_ID]/
SHEET_MARCADOR_ID=

# API Key de Google Cloud para leer Sheets públicas sin OAuth.
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
# Activar: Google Sheets API en el proyecto de Google Cloud.
GOOGLE_SHEETS_API_KEY=

# ── Google Sheets (alternativa OAuth — solo si se necesita acceso a hoja privada) ──
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── Fase 2: Clima por ciudad ──────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Fase 4: Gina (asistente IA con Claude) ───────────────────────────────────
# Obtené la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Fase 5: Base de datos ─────────────────────────────────────────────────────
# Vercel Postgres / Neon / Supabase — se define en esta fase
DATABASE_URL=

# ── Fase 6: Pagos ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
