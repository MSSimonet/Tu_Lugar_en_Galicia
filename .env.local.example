# .env.local.example
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repo (ya está en .gitignore).
# Las mismas variables deben cargarse en Vercel → Settings → Environment Variables.

# ── Fase 1: Leads y El Marcador ──────────────────────────────────────────────
AIRTABLE_API_KEY=
# Si usás Google Sheets en lugar de Airtable, completá estas tres:
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
# ID de la hoja de cálculo que alimenta El Marcador de precios:
SHEET_MARCADOR_ID=

# ── Fase 2: Clima por ciudad ──────────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Fase 4: Lar (asistente IA con Claude) ────────────────────────────────────
# Obtené la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Fase 5: Base de datos ─────────────────────────────────────────────────────
# Vercel Postgres / Neon / Supabase — se define en esta fase
DATABASE_URL=

# ── Fase 6: Pagos ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
