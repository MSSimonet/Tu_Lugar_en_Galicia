# .env.local.example
# Copiá este archivo a .env.local y completá los valores reales.
# NUNCA subas .env.local al repo (ya está en .gitignore).
# Las mismas variables deben cargarse en Vercel → Settings → Environment Variables.

# (Eliminadas — Fase 5 de retiro de Airtable, 2026-07-16: AIRTABLE_API_KEY, AIRTABLE_BASE_ID,
# AIRTABLE_TABLE_NAME, AIRTABLE_COMUNIDAD_TABLE_NAME. El proyecto ya no usa Airtable para nada —
# leads migró a Supabase el 2026-07-12 y el puente de Comunidad se eliminó el 2026-07-16, ver
# docs/crm-supabase-fase0.md §3. Ver git history si hace falta el detalle de estas variables.)

# ── Fase 1: El Marcador (Google Sheets) ──────────────────────────────────────
# ID de la Google Sheet del Marcador. En la URL: docs.google.com/spreadsheets/d/[SHEET_MARCADOR_ID]/
SHEET_MARCADOR_ID=

# API Key de Google Cloud para leer Sheets públicas sin OAuth.
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
# Activar: Google Sheets API en el proyecto de Google Cloud.
GOOGLE_SHEETS_API_KEY=

# (Eliminadas — ver git history: GOOGLE_SHEETS_CLIENT_EMAIL, GOOGLE_SHEETS_PRIVATE_KEY, GOOGLE_SHEETS_SPREADSHEET_ID, OPENWEATHER_API_KEY)

# (Eliminada — ADR-008 superseded, 2026-07-16: GEMINI_API_KEY. Se descartó integrar un LLM
# externo para Gina para evitar alucinaciones en temas de visado/documentación migratoria.
# Gina es y sigue siendo un motor de reglas determinista, ver docs/ARCHITECTURE.md ADR-008.)

# ── Fase 5: Comunidad de Acogida (Supabase) ───────────────────────────────────
# Ver docs/comunidad-de-acogida.md. Obtener en: Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave con privilegios de servidor (bypassea RLS) — SOLO server-side, nunca en el cliente.
# Sin esta clave, /api/comunidad/registro y /api/comunidad/mensaje responden 503 (fail-closed).
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Postgres / Neon — alternativa si no se usa Supabase para otra necesidad de datos
DATABASE_URL=

# ── Fase 6: Pagos ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=

AEMET_API_KEY=           # Clave de la API de AEMET (clima en tiempo real). Obtener en: https://opendata.aemet.es/centrodedescargas/inicio

# ── Feed de Instagram (Instagram API with Instagram Login) ───────────────────
# App ID de la app de Meta (developers.facebook.com → tu app → Configuración básica).
# No es secreto, pero hace falta para armar el link de autorización y canjear el code.
INSTAGRAM_APP_ID=

# App secret de la app de Meta (Configuración básica → Secreto de la aplicación, 32 hex).
# Se usa para canjear el code/short-lived token por uno de larga duración — el refresco
# periódico (app/api/admin/instagram/refrescar-token) no lo necesita.
INSTAGRAM_APP_SECRET=

# ── General ───────────────────────────────────────────────────────────────────
# URL pública del sitio — se usa para validar el Origin en los endpoints POST.
# En producción: https://tu-lugar-en-galicia.vercel.app
# En preview: la URL de Vercel del deploy (o dejar vacío para aceptar cualquier origen)
NEXT_PUBLIC_SITE_URL=https://tu-lugar-en-galicia.vercel.app

# ── Seguridad: endpoints internos ─────────────────────────────────────────────
# Secret para proteger endpoints internos y firmar tokens de admin (HMAC-SHA256).
# Generar con: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────────
# OBLIGATORIAS. Los 7 endpoints con rate limit son fail-closed: si faltan estas dos
# variables responden 503 y no procesan nada — /api/gina, /api/contacto, /api/lead,
# /api/comunidad/registro, /api/comunidad/mensaje, /api/plan/[recordId]/pdf y
# /api/admin/habilitar-agenda/[recordId]. Sin ellas, el cuestionario de Gina y el
# formulario de contacto quedan caídos en silencio.
# Obtener en: https://console.upstash.com → tu base Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Flujo de agenda (Resend + Cal.com) ────────────────────────────────────────
# Resend: https://resend.com → API Keys
RESEND_API_KEY=

# Dirección "from" para mails al cliente. Cuando el dominio esté activo:
#   "Tu Lugar en Galicia <silvana@tulugarengalicia.com>"
# Mientras tanto, usar el dominio de Resend (onboarding@resend.dev) o dejar vacío.
RESEND_FROM_EMAIL=

# Email de Silvana — destino de mails internos (resumen diario, recordatorios)
SILVANA_EMAIL=

# (Eliminada — 2026-08-01: CALCOM_API_KEY. Nunca se usó en el código: los webhooks se
# verifican con CALCOM_WEBHOOK_SECRET, de abajo, y la gestión de slots vía API (Pieza 7)
# no llegó a implementarse. Si alguna vez se implementa, volver a añadirla acá.)

# Cal.com Webhook Secret — para verificar la firma HMAC-SHA256 de los webhooks de Cal.com.
# Obtener en: https://cal.com/settings/developer/webhooks → crear webhook → copiar el "secret"
# URL del webhook: https://tulugarengalicia.com/api/webhooks/calcom
# Eventos a activar: BOOKING_CREATED
CALCOM_WEBHOOK_SECRET=

# Vercel Cron Secret — lo usa Vercel para autenticar llamadas del cron job diario.
# IMPORTANTE: configurar en Vercel → Settings → Environment Variables con el mismo valor
# que INTERNAL_API_SECRET (o uno distinto si se prefiere separar los secretos).
# Vercel lo inyecta automáticamente como header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Login real de /admin (NextAuth / Auth.js) ─────────────────────────────────
# Una sola cuenta (Silvana) — sin multiusuario ni roles. Protege /admin/* en
# middleware.ts (no afecta a /api/admin/* ni /api/webhooks/*, que siguen con
# su propio Bearer secret de arriba).

# Secreto para firmar/cifrar la sesión JWT de NextAuth. Generar con:
# openssl rand -hex 32
NEXTAUTH_SECRET=

# URL pública del sitio para NextAuth. Opcional en Vercel (se autodetecta),
# pero documentala igual para dev local: http://localhost:3000
NEXTAUTH_URL=

# Email de la única cuenta admin (texto plano, no es secreto).
ADMIN_EMAIL=

# Hash bcrypt de la contraseña admin — generar una vez y pegar el hash acá,
# la contraseña en texto plano nunca vive en el repo ni en Vercel.
# Ejemplo para generarlo: node -e "require('bcryptjs').hash('tu-password', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
