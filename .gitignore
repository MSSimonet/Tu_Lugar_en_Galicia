# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# example file is safe to commit — has no real values
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# unlighthouse audit output
.unlighthouse/
docs/unlighthouse-tlg8/
docs/unlighthouse-tlg8-post/
docs/auditoria-tlg8.md

# auditorías de limpieza de repo (knip/unlighthouse) — output local, no commitear
.audit/

# marcador de sesión — no commitear
.claude/.precompact-done
